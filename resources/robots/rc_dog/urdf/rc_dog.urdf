<?xml version="1.0" encoding="UTF-8"?>
<robot name="rc_dog">
  <!--
    Isaac Gym training model derived from the SolidWorks export.
    Coordinate convention: x forward, y left, z up.
    Joint and link names follow the A1 FR/FL/RR/RL convention.
  -->

  <material name="body_grey">
    <color rgba="0.752941 0.752941 0.752941 1"/>
  </material>
  <material name="hip_white">
    <color rgba="1 1 1 1"/>
  </material>
  <material name="leg_light">
    <color rgba="0.898039 0.917647 0.929412 1"/>
  </material>
  <material name="leg_dark">
    <color rgba="0.64706 0.61961 0.58824 1"/>
  </material>
  <material name="calf_blue">
    <color rgba="0.792157 0.819608 0.933333 1"/>
  </material>
  <material name="foot_grey">
    <color rgba="0.84314 0.81569 0.75294 1"/>
  </material>
  <material name="imu_red">
    <color rgba="0.8 0 0 1"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.661"/>
      <inertia ixx="0.03131" ixy="4.85296702838236e-05" ixz="2.32312668477577e-05"
               iyy="0.05735" iyz="-3.6491782731198e-05" izz="0.07513"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/base_link.STL"/>
      </geometry>
      <material name="body_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.014" rpy="0 0 0"/>
      <geometry>
        <box size="0.36 0.24 0.14"/>
      </geometry>
    </collision>
  </link>

  <joint name="imu_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
      <material name="imu_red"/>
    </visual>
  </link>

  <!-- Front right leg. -->
