        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="/home/wry/mpc_simulation_ws/src/unitree_ros/robots/rc_dog/meshes/rf_hip_Link.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="rf__hip"
    type="revolute">
    <origin
      xyz="0.23866 -0.1 0"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="rf_hip_Link" />
    <axis
      xyz="1 0 0" />
    <limit
      lower="-0.863"
      upper="0.863"
      effort="23.7"
      velocity="30.1" />
    <dynamics
      damping="0"
      friction="0" />
  </joint>
  <link
    name="rf_leg1_Link">
    <inertial>
      <origin
        xyz="-3.73612e-3 -2.658411e-02 -2.539968e-02"
        rpy="0 0 0" />
      <mass
        value="9.4153487e-1" />
      <inertia
        ixx="4.04710e-03"
        ixy="-9.849e-05"
        ixz="3.3391e-04"
        iyy="4.05785e-03"
        iyz="-6.2094e-04"
        izz="1.18353e-03" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
